{
  "name": "soffia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first Markdown study workspace with a reader, quizzes, flashcards, and optional private cloud sync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmpolStack/soffia.git"
  },
  "keywords": [
    "markdown",
    "study",
    "spaced-repetition",
    "flashcards",
    "reader",
    "react",
    "vite",
    "dotnet"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/build-llms.mjs && vite",
    "dev:cloud": "node scripts/build-llms.mjs && vite --mode cloud",
    "build": "node scripts/build-llms.mjs && tsc --noEmit && vite build",
    "build:cloud": "node scripts/build-llms.mjs && tsc --noEmit && vite build --mode cloud",
    "build:single": "node scripts/build-llms.mjs && tsc --noEmit && vite build --mode single && node scripts/rename-single.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node skill/soffia/scripts/validate.mjs examples/impetigo/seminario.md",
    "validate:all": "node skill/soffia/scripts/validate.mjs examples",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:api": "node scripts/test-api.mjs",
    "mcp": "node mcp/soffia-server.mjs",
    "install:skill": "node scripts/install-skill.mjs",
    "install:skill:project": "node scripts/install-skill.mjs --project"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/red-rose": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.65.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
