# Login local (npm run build y npm run build:single).
# Copia este archivo a .env.local para cambiarlo.
# Límites: nombre <= 20 caracteres; usuario <= 15; contraseña <= 70 bytes.
# Estas credenciales quedan dentro del bundle: es una pantalla de acceso local,
# no seguridad de servidor. Para seguridad real, usa el modo nube con la API.
VITE_LOCAL_AUTH_NAME=Soffia
VITE_LOCAL_AUTH_USERNAME=soffia
VITE_LOCAL_AUTH_PASSWORD=soffia
