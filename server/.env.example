# Credenciales del único usuario. Son obligatorias.
# Límites: nombre visible <= 20 caracteres; usuario <= 15 caracteres;
# cada credencial <= 70 bytes UTF-8.
APP_AUTHENTICATION_NAME=Soffia
APP_AUTHENTICATION_USERNAME=soffia
APP_AUTHENTICATION_PASSWORD=cambia-esta-contrasena

# Secreto de firma de la cookie de sesión: mínimo 32 bytes.
# Genera uno con: openssl rand -hex 32
APP_SESSION_SECRET=0123456789abcdef0123456789abcdef

# Producción detrás de un proxy (Render, Cloudflare Pages Functions).
TRUST_PROXY=true
ASPNETCORE_ENVIRONMENT=Production
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=lax

# CORS solo si el frontend llama directamente a la API desde otro origen.
# Con el proxy de Cloudflare Pages no hace falta.
# CORS_ORIGINS=https://soffia.pages.dev

# Cloudflare R2 (recomendado en producción; sin R2 se usa disco local).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Solo para desarrollo local sin R2.
# DATA_DIR=C:\Users\tu-usuario\AppData\Local\Temp\soffia-api-data
